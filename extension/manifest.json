{
  "manifest_version": 3,
  "name": "Wimm — голосовой блокнот",
  "description": "Голосовые и текстовые заметки, снимки вкладок и личный документ с секретарём Claude.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wimm — сохранить в блокнот"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "studio.html#settings",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
